node_modules/
dist/
shots/
*.log
.DS_Store
dist-single/
dist-release/
dist-single-release/
.audit/
# Every `tools/check-*.mjs` bundles its entry point into a scratch directory
# like `.roofaudit` and deletes it on the way out. An interrupted run leaves
# one behind; none of them are ever worth committing.
.*audit/

# Agent worktrees and local Claude Code state. Each overhaul agent works in
# its own copy under .claude/worktrees and pushes its checkpoints to the
# branch; the copies themselves are never part of the repository.
.claude/
.checks/
# The worktrees symlink node_modules, and a trailing-slash pattern does not match a symlink.
node_modules
# BC7 textures packed from public/assets/textures by tools/pack-textures.mjs,
# which `npm run build` runs first.
public/ktx2/
# Hero and townsfolk bodies meshed ahead by tools/build-meshes.mjs, which
# `npm run build` runs first; .meshbuild is its scratch folder.
public/meshes/
.meshbuild/
